# SecBrain backend configuration (copy to .env for native dev).
# All variables are prefixed SECBRAIN_. Defaults are safe for offline dev.

# --- Application ---
SECBRAIN_ENVIRONMENT=development
SECBRAIN_DEBUG=true
SECBRAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security (CHANGE IN PRODUCTION; use >= 32 random bytes) ---
SECBRAIN_SECRET_KEY=dev-insecure-change-me-min-32-bytes-long-000
SECBRAIN_ACCESS_TOKEN_TTL_MINUTES=720

# --- Database ---
# SQLite (native dev, zero infra):
SECBRAIN_DATABASE_URL=sqlite:///./data/secbrain.db
# PostgreSQL (docker/prod):
# SECBRAIN_DATABASE_URL=postgresql+psycopg://secbrain:secbrain@localhost:5432/secbrain

# --- Storage ---
SECBRAIN_STORAGE_DIR=./data/storage

# --- Embedding provider: fake | ollama | openai ---
SECBRAIN_EMBEDDING_PROVIDER=fake
SECBRAIN_EMBEDDING_MODEL=fake-hash-256
SECBRAIN_EMBEDDING_DIM=256
SECBRAIN_EMBEDDING_BASE_URL=http://localhost:11434
# SECBRAIN_EMBEDDING_API_KEY=

# --- Generation provider: fake | ollama | openai ---
SECBRAIN_LLM_PROVIDER=fake
SECBRAIN_LLM_MODEL=fake-echo
SECBRAIN_LLM_BASE_URL=http://localhost:11434
# SECBRAIN_LLM_API_KEY=
SECBRAIN_LLM_CONTEXT_TOKENS=4096
SECBRAIN_LLM_MAX_OUTPUT_TOKENS=512
SECBRAIN_LLM_TEMPERATURE=0.1
SECBRAIN_LLM_TIMEOUT_SECONDS=300

# Set true to forbid ALL outbound model calls (air-gapped / privacy mode).
SECBRAIN_DISABLE_OUTBOUND_LLM=false

# --- Vector store: memory | qdrant ---
SECBRAIN_VECTOR_STORE=memory
SECBRAIN_QDRANT_URL=http://localhost:6333
# SECBRAIN_QDRANT_API_KEY=

# --- Retrieval tuning ---
SECBRAIN_RETRIEVAL_TOP_K=4
SECBRAIN_CHUNK_TARGET_TOKENS=250
SECBRAIN_RETRIEVAL_MIN_LEXICAL=0.30
SECBRAIN_RETRIEVAL_REQUIRE_LEXICAL_GROUNDING=true

# --- Text-to-speech (Nyx voice) ---
# none | piper  (piper = local neural TTS, CPU, offline)
SECBRAIN_TTS_PROVIDER=piper
SECBRAIN_TTS_VOICE_NAME=Nyx
SECBRAIN_PIPER_VOICE_PATH=./data/voices/en_US-amy-medium.onnx
SECBRAIN_TTS_LENGTH_SCALE=1.0
# Download the voice model once with: python -m app.cli download-voice

# --- System actions (nmap / app launch) — DISABLED by default (fail closed) ---
SECBRAIN_ACTIONS_ENABLED=false
SECBRAIN_NMAP_BINARY=nmap
SECBRAIN_NMAP_TIMEOUT_SECONDS=180
# JSON map of friendly app name -> argv list (only these can be launched):
SECBRAIN_ALLOWED_APPS={}
# JSON array of CIDR/host entries always allowed as scan targets (lab/loopback
# only). Prefer defining authorized scope via an Engagement instead.
SECBRAIN_ACTION_SCOPE_ALLOWLIST=[]

# --- Remote / LAN access ---
# Allow any browser origin (self-hosted single-tenant). Safe here because auth
# is a Bearer header, not cookies. Alternatively list exact origins in
# SECBRAIN_CORS_ORIGINS instead of enabling this.
SECBRAIN_CORS_ALLOW_ALL=false
# When running natively for remote access, bind all interfaces:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000

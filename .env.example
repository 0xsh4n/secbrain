# Root environment for `docker compose`. Copy to .env and adjust.

# --- Postgres ---
POSTGRES_USER=secbrain
POSTGRES_PASSWORD=secbrain
POSTGRES_DB=secbrain

# --- Backend security (CHANGE THESE) ---
SECBRAIN_SECRET_KEY=change-me-in-production-min-32-bytes-long
SECBRAIN_BOOTSTRAP_ADMIN_EMAIL=admin@secbrain.local
SECBRAIN_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin-123
SECBRAIN_CORS_ORIGINS=http://localhost:3000

# --- Vector store: memory (default) | qdrant ---
# To use Qdrant: set this to qdrant AND start compose with: --profile qdrant
SECBRAIN_VECTOR_STORE=memory

# --- Embedding provider: fake | ollama | openai ---
# Defaults to fake (offline hashing).
# For Ollama on host, use:
#   SECBRAIN_EMBEDDING_PROVIDER=ollama
#   SECBRAIN_EMBEDDING_BASE_URL=http://host.docker.internal:11434
#   SECBRAIN_EMBEDDING_MODEL=nomic-embed-text
#   SECBRAIN_EMBEDDING_DIM=768
SECBRAIN_EMBEDDING_PROVIDER=fake
SECBRAIN_EMBEDDING_BASE_URL=http://ollama:11434
SECBRAIN_EMBEDDING_MODEL=fake-hash-256
SECBRAIN_EMBEDDING_DIM=256

# --- Generation (LLM) provider: fake | ollama | openai ---
# Defaults to fake (offline grounded echo).
# For Ollama on host:
#   SECBRAIN_LLM_PROVIDER=ollama
#   SECBRAIN_LLM_BASE_URL=http://host.docker.internal:11434
#   SECBRAIN_LLM_MODEL=qwen2.5:3b     # or llama3.2:3b, qwen2.5:7b
#   SECBRAIN_LLM_CONTEXT_TOKENS=8192
#   SECBRAIN_LLM_MAX_OUTPUT_TOKENS=4096
#   SECBRAIN_LLM_TIMEOUT_SECONDS=300
SECBRAIN_LLM_PROVIDER=fake
SECBRAIN_LLM_MODEL=fake-echo
SECBRAIN_LLM_BASE_URL=http://ollama:11434
SECBRAIN_LLM_CONTEXT_TOKENS=8192
SECBRAIN_LLM_MAX_OUTPUT_TOKENS=4096
SECBRAIN_LLM_TEMPERATURE=0.1
SECBRAIN_LLM_TIMEOUT_SECONDS=120

# --- Retrieval tuning (affects prompt size & speed) ---
SECBRAIN_RETRIEVAL_TOP_K=4
SECBRAIN_RETRIEVAL_MAX_SCAN_CHUNKS=5000
SECBRAIN_CHUNK_TARGET_TOKENS=250

# Seed the synthetic sample corpus on first start.
SECBRAIN_SEED_SAMPLES_ON_START=true

# --- Optional Google Drive knowledge-pool sync ---
# Create a Google OAuth web client; enable Drive API; add the callback URL below
# as an Authorized redirect URI; add yourself as a test user while the app is in testing.
SECBRAIN_GOOGLE_DRIVE_CLIENT_ID=
SECBRAIN_GOOGLE_DRIVE_CLIENT_SECRET=
SECBRAIN_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/drive-sync/callback
SECBRAIN_GOOGLE_DRIVE_FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# Browser-facing API URL (inlined into the frontend at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000

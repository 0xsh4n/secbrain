# Root environment for `docker compose`. Copy to .env and adjust.

# --- Postgres ---
POSTGRES_USER=secbrain
POSTGRES_PASSWORD=secbrain
POSTGRES_DB=secbrain

# --- Backend security (CHANGE THESE) ---
SECBRAIN_SECRET_KEY=change-me-in-production-min-32-bytes-long
SECBRAIN_BOOTSTRAP_ADMIN_EMAIL=admin@secbrain.local
SECBRAIN_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin-123
SECBRAIN_CORS_ORIGINS=http://localhost:3000

# --- Vector store: memory (default) | qdrant ---
# To use Qdrant: set this to qdrant AND start compose with: --profile qdrant
SECBRAIN_VECTOR_STORE=memory

# --- Models (default offline/deterministic providers) ---
# fake | ollama | openai. For local models start compose with: --profile models
SECBRAIN_EMBEDDING_PROVIDER=fake
SECBRAIN_LLM_PROVIDER=fake
SECBRAIN_LLM_BASE_URL=http://ollama:11434
SECBRAIN_EMBEDDING_BASE_URL=http://ollama:11434

# Seed the synthetic sample corpus on first start.
SECBRAIN_SEED_SAMPLES_ON_START=true

# --- Frontend ---
# Browser-facing API URL (inlined into the frontend at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
